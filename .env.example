# Copy to .env only if you want to override a default; every setting below
# already has a working value baked in. See docs/DEPLOYMENT.md for the full list.

# Server
PORT=8000

# Public-demo guardrails: requests allowed per window, per client IP
ICD10_RATE_LIMIT_REQUESTS=60
ICD10_RATE_LIMIT_WINDOW=60

# Retrieval. Changing the model or the text variant requires rebuilding the
# index (`make index`); the service refuses to start on a mismatch.
ICD10_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ICD10_DOC_TEXT_VARIANT=desc_incl_parent
ICD10_RRF_K=10
ICD10_RRF_WEIGHT_DENSE=1.0
ICD10_RRF_WEIGHT_LEXICAL=1.0

# No API keys are needed. The embedding model runs locally on CPU via ONNX.
